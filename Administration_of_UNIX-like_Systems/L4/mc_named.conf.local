// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

zone "mcduckcorp.duckburg.cali." {
	type master;
	file "/etc/bind/mcduckcorp.db";
};

//Reverse-zonfil
zone "9.0.10.in-addr.arpa" {
	type master;
	file "/etc/bind/9.0.10.in-addr.arpa.db";
};
